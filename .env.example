# 寻迹线索工作台：服务器部署配置示例
# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env
# 不要把 .env 提交到仓库；这里不需要、也不要填写任何 AWS 密钥（S3 上传使用 EC2 实例角色）。

# ---- Docker Compose / Caddy ----
# 访问主机名。没有域名时用公网 IP 加 sslip.io，例如 IP 3.1.2.4 → 3-1-2-4.sslip.io
LEAD_PUBLIC_HOST=<公网IP用短横线连接>.sslip.io
# 证书：acme = Let's Encrypt 真证书（默认）；internal = Caddy 内部自签证书（浏览器会提示不安全）
LEAD_TLS=acme
# 仅本机验证用：公开地址的端口后缀，例如 :18853；云上留空
LEAD_PUBLIC_PORT_SUFFIX=
# 宿主机端口（云上保持 80 / 443）
LEAD_HTTP_PORT=80
LEAD_HTTPS_PORT=443
# 数据卷名（云上保持默认）
LEAD_VOLUME_NAME=leadworkbench-data

# ---- 应用 ----
# 模式：server（服务器部署，compose 已固定）或 local（本机，scripts/start.sh 默认）
# LEAD_MODE=server
# 登录：server 模式必须为 on
# LEAD_AUTH=on
# 公开来源，compose 已由 LEAD_PUBLIC_HOST 拼出，一般不用设置
# LEAD_PUBLIC_ORIGIN=https://<公网IP用短横线连接>.sslip.io
# 额外允许的主机名（逗号分隔，最多 10 个；公开来源的主机名和本机回环名会自动加入）
# LEAD_ALLOWED_HOSTS=
# 监听地址与端口（镜像内为 0.0.0.0:8000，不对外发布）
# LEAD_BIND=0.0.0.0
# LEAD_PORT=8000
# 数据目录（镜像内为 /data，对应数据卷）
# LEAD_DATA_DIR=/data
# Maps 程序与 Playwright 路径（镜像内使用默认路径，一般不用设置）
# MAPS_SCRAPER_BIN=
# PLAYWRIGHT_BROWSERS_PATH=
# PLAYWRIGHT_DRIVER_PATH=

# 会话：空闲多少小时后需重新登录（1–720），最长多少天（1–90，且不短于空闲时长）
LEAD_SESSION_IDLE_HOURS=24
LEAD_SESSION_MAX_DAYS=7

# ---- 每日备份 ----
# server 默认 on；时间为 24 小时制，按 LEAD_TIMEZONE
LEAD_BACKUP_DAILY=on
LEAD_BACKUP_TIME=03:30
LEAD_TIMEZONE=Asia/Shanghai
# S3 上传：留空则只做本地备份。设置桶名时必须同时设置区域（例如 ap-northeast-1 或 us-east-1）
LEAD_BACKUP_S3_BUCKET=
# LEAD_BACKUP_S3_BUCKET=<你的桶名>
LEAD_BACKUP_S3_REGION=
LEAD_BACKUP_S3_PREFIX=leadworkbench/

# 日志级别
LEAD_LOG_LEVEL=INFO
