# 寻迹线索工作台反向代理（AWS trial, design §3.5）。
# LEAD_PUBLIC_HOST：访问主机名（例如 3-1-2-4.sslip.io）；LEAD_TLS：acme（Let's Encrypt，默认）或 internal（内部自签证书）。
{
	admin off
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

(tls_acme) {
	header Strict-Transport-Security "max-age=86400"
}
(tls_internal) {
	tls internal
}

{$LEAD_PUBLIC_HOST} {
	import tls_{$LEAD_TLS:acme}
	header -Server
	request_body {
		max_size 2MB
	}
	encode gzip
	# 公开的合作伙伴介绍页（不需要登录，请求不经过应用）：只提供 docker-compose.yml 挂载的
	# 单个文件 docs/partner/index.html。/about/ 跳转到 /about；/about/ 下其他任何路径一律 404，
	# 不落到应用，也不列目录。停用：删除本段和 caddy 的 /srv/about 挂载，然后 docker compose up -d caddy。
	@about path /about /about/*
	handle @about {
		route {
			header {
				Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
				X-Robots-Tag "noindex, nofollow"
				X-Content-Type-Options nosniff
				Referrer-Policy no-referrer
				Cache-Control "public, max-age=300"
			}
			redir /about/ /about 308
			respond /about/* 404
			root * /srv/about
			rewrite * /index.html
			file_server
		}
	}
	handle {
		reverse_proxy api:8000
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Local-Token delete
				request>headers>Cookie delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
