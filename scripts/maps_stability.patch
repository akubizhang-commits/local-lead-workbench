@@ -0,0 +1,177 @@
+package gmaps
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gosom/scrapemate"
+	"github.com/gosom/scrapemate/adapters/fetchers/jshttp"
+	"github.com/gosom/scrapemate/adapters/providers/memory"
+)
+
+type localFailingFetcher struct {
+	calls int
+}
+
+func (f *localFailingFetcher) Fetch(context.Context, scrapemate.IJob) scrapemate.Response {
+	f.calls++
+	return scrapemate.Response{StatusCode: 429, Error: errors.New("HTTP 429 fixture")}
+}
+
+func (*localFailingFetcher) Close() error { return nil }
+
+func TestLocalStabilityFailedJobsFetchOnlyOnce(t *testing.T) {
+	jobs := map[string]scrapemate.IJob{
+		"search": NewGmapJob("fixture", "en", "fixture", 1, false, "", 0),
+		"place":  NewPlaceJob("fixture", "en", "https://www.google.com/maps/place/fixture", false, false),
+		"fast":   NewSearchJob(&MapSearchParams{Query: "fixture"}),
+		"email":  NewEmailJob("fixture", &Entry{WebSite: "https://fixture.invalid"}),
+	}
+	for name, job := range jobs {
+		t.Run(name, func(t *testing.T) {
+			fetcher := &localFailingFetcher{}
+			mate, err := scrapemate.New(
+				scrapemate.WithHTTPFetcher(fetcher),
+				scrapemate.WithJobProvider(memory.New()),
+			)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer mate.Close()
+			_, _, _ = mate.DoJob(context.Background(), job)
+			if fetcher.calls != 1 {
+				t.Fatalf("failed job fetched %d times; durable queue must own retries", fetcher.calls)
+			}
+		})
+	}
+}
+
+type localFixturePage struct {
+	scrapemate.BrowserPage
+	navigations int
+	status      int
+	raw         any
+	reloads     int
+	evals       int
+}
+
+func (p *localFixturePage) Goto(string, scrapemate.WaitUntilState) (*scrapemate.PageResponse, error) {
+	p.navigations++
+	if p.status != 0 {
+		return &scrapemate.PageResponse{StatusCode: p.status}, nil
+	}
+	return nil, errors.New("navigation fixture")
+}
+
+func (p *localFixturePage) Eval(string, ...any) (any, error) {
+	p.evals++
+	return p.raw, nil
+}
+
+func (p *localFixturePage) Reload(scrapemate.WaitUntilState) error {
+	p.reloads++
+	return nil
+}
+
+func TestLocalStabilityCancelledJobsDoNotNavigate(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	jobs := []scrapemate.IJob{
+		NewGmapJob("fixture", "en", "fixture", 1, false, "", 0),
+		NewPlaceJob("fixture", "en", "https://www.google.com/maps/place/fixture", false, false),
+	}
+	for _, job := range jobs {
+		page := &localFixturePage{}
+		resp := job.BrowserActions(ctx, page)
+		if page.navigations != 0 || !errors.Is(resp.Error, context.Canceled) {
+			t.Fatalf("cancelled job navigated %d times: %v", page.navigations, resp.Error)
+		}
+	}
+}
+
+func TestLocalStabilityRejectedPagesStopBeforeActions(t *testing.T) {
+	prior := localNavigation
+	localNavigation = newNavigationPacer(0)
+	defer func() { localNavigation = prior }()
+	jobs := []scrapemate.IJob{
+		NewGmapJob("fixture", "en", "fixture", 1, false, "", 0),
+		NewPlaceJob("fixture", "en", "https://www.google.com/maps/place/fixture", false, false),
+	}
+	for _, status := range []int{403, 429} {
+		for _, job := range jobs {
+			page := &localFixturePage{status: status}
+			resp := job.BrowserActions(context.Background(), page)
+			if resp.Error == nil || !strings.Contains(resp.Error.Error(), "HTTP ") {
+				t.Fatalf("restriction was not explicit: %v", resp.Error)
+			}
+			if page.navigations != 1 || page.evals != 0 || page.reloads != 0 {
+				t.Fatalf("rejected page performed further actions: %+v", page)
+			}
+		}
+	}
+}
+
+func TestLocalStabilityDetailDeadlineDoesNotReload(t *testing.T) {
+	job := NewPlaceJob("fixture", "en", "https://www.google.com/maps/place/fixture", false, false)
+	page := &localFixturePage{}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	start := time.Now()
+	_, err := job.extractJSON(ctx, page)
+	if !errors.Is(err, context.DeadlineExceeded) || time.Since(start) > time.Second {
+		t.Fatalf("detail read ignored parent deadline: %v", err)
+	}
+	if page.reloads != 0 || page.evals == 0 {
+		t.Fatalf("expected local polling without reload: %+v", page)
+	}
+}
+
+func TestLocalStabilityDetailDataPreserved(t *testing.T) {
+	job := NewPlaceJob("fixture", "en", "https://www.google.com/maps/place/fixture", false, false)
+	page := &localFixturePage{raw: `)]}' {"fixture":"preserved"}`}
+	raw, err := job.extractJSON(context.Background(), page)
+	if err != nil || string(raw) != `{"fixture":"preserved"}` || page.reloads != 0 {
+		t.Fatalf("detail data changed: %s, %v", raw, err)
+	}
+}
+
+func TestLocalStabilityNavigationGapAndCancellation(t *testing.T) {
+	const gap = 25 * time.Millisecond
+	pacer := newNavigationPacer(gap)
+	page := &localFixturePage{status: 200}
+	if _, err := pacer.gotoPage(context.Background(), page, "fixture"); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	if _, err := pacer.gotoPage(context.Background(), page, "fixture"); err != nil {
+		t.Fatal(err)
+	}
+	if time.Since(start) < gap {
+		t.Fatal("consecutive navigation did not wait for the gap")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := pacer.gotoPage(ctx, page, "fixture"); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled navigation continued: %v", err)
+	}
+	if page.navigations != 2 {
+		t.Fatalf("cancelled wait navigated: %d", page.navigations)
+	}
+}
+
+func TestLocalStabilityChromiumIsNotSingleProcess(t *testing.T) {
+	args := jshttp.LocalChromiumLaunchArgs()
+	for _, flag := range []string{"--single-process", "--no-zygote"} {
+		for _, arg := range args {
+			if arg == flag {
+				t.Fatalf("Chromium launch args still contain %s", flag)
+			}
+		}
+	}
+	if len(args) == 0 || localChromiumSingleProcess() {
+		t.Fatalf("unexpected Chromium launch args: %v", args)
+	}
+}
