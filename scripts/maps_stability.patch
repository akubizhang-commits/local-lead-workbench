+package gmaps
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"time"
+
+	"github.com/gosom/scrapemate"
+	"github.com/gosom/scrapemate/adapters/fetchers/jshttp"
+)
+
+// This downstream policy is version-bound by scripts/patch_maps_stability.py.
+// The durable Python queue owns all retries and pauses between search jobs.
+const (
+	localMaxRetries    = 0
+	localNavigationGap = 5 * time.Second
+	localPatchVersion  = "local-maps-stability-v2"
+)
+
+type navigationPacer struct {
+	permit    chan struct{}
+	notBefore time.Time
+	gap       time.Duration
+}
+
+var localNavigation = newNavigationPacer(localNavigationGap)
+
+func newNavigationPacer(gap time.Duration) *navigationPacer {
+	return &navigationPacer{permit: make(chan struct{}, 1), gap: gap}
+}
+
+func localWait(ctx context.Context, delay time.Duration) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if delay <= 0 {
+		return nil
+	}
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return ctx.Err()
+	}
+}
+
+func (p *navigationPacer) gotoPage(ctx context.Context, page scrapemate.BrowserPage, url string) (*scrapemate.PageResponse, error) {
+	select {
+	case p.permit <- struct{}{}:
+		defer func() { <-p.permit }()
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	if err := localWait(ctx, time.Until(p.notBefore)); err != nil {
+		return nil, err
+	}
+	// Serialize navigation and leave a gap after each completion, including errors.
+	defer func() { p.notBefore = time.Now().Add(p.gap) }()
+	resp, err := page.Goto(url, scrapemate.WaitUntilDOMContentLoaded)
+	if err != nil {
+		return nil, err
+	}
+	if resp == nil {
+		return nil, fmt.Errorf("Maps navigation returned no response")
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		// Stop before cookie clicks, scrolling or detail polling on a rejected page.
+		return nil, fmt.Errorf("Maps navigation HTTP %d", resp.StatusCode)
+	}
+	return resp, nil
+}
+
+// localChromiumSingleProcess reports whether the compiled scrapemate launches
+// Chromium with --single-process. jshttp.LocalChromiumLaunchArgs only exists
+// when scripts/maps_scrapemate_launch.patch is applied via the build overlay,
+// so a build without it fails to compile instead of shipping the crash.
+func localChromiumSingleProcess() bool {
+	return slices.Contains(jshttp.LocalChromiumLaunchArgs(), "--single-process")
+}
+
+// LocalStabilityInfo reports the compiled policy without opening a browser.
+func LocalStabilityInfo() map[string]any {
+	return map[string]any{
+		"patch":                   localPatchVersion,
+		"search_max_retries":      NewGmapJob("check", "en", "check", 1, false, "", 0).GetMaxRetries(),
+		"place_max_retries":       NewPlaceJob("check", "en", "https://www.google.com/maps/place/check", false, false).GetMaxRetries(),
+		"fast_search_max_retries": NewSearchJob(&MapSearchParams{Query: "check"}).GetMaxRetries(),
+		"detail_reload":           false,
+		"navigation_gap_seconds":  int(localNavigationGap / time.Second),
+		"chromium_single_process": localChromiumSingleProcess(),
+	}
+}
